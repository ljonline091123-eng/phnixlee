<o:Shortcut Ref="o2194"/>
</c:InfluentObject>
<c:Annotations>
<o:Annotation Id="o2195">
<a:ObjectID>6590517E-4BFD-4667-A710-DE014EE61632</a:ObjectID>
<a:CreationDate>1728719974</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728719974</a:ModificationDate>
