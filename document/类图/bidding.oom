<o:Attribute Id="o4623">
<a:ObjectID>02D84812-B58B-4E1F-9061-B6FC4F606BE1</a:ObjectID>
<a:Name>twiceQuotVersion</a:Name>
<a:Code>twiceQuotVersion</a:Code>
