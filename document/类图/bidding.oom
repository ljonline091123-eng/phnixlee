<o:Operation Id="o2173">
<a:ObjectID>11536F41-81A4-487A-B079-16B2CA5D6266</a:ObjectID>
<a:Name>校验废标参数_verifyParam</a:Name>
<a:Code>verifyParam</a:Code>
<a:CreationDate>1728719974</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720008</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Comment>校验废标参数</a:Comment>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    AbandonMoreVO abandonMoreVO = abandonMoreVOList.get(0);
    if (ObjectUtils.isEmpty(abandonMoreVO)){
        throw new ParamValidateException(&quot;暂无招标数据，无法废标&quot;);
    }
    if (null == abandonMoreVO.getNoticeId()){
        throw new ParamValidateException(&quot;暂无招标数据，无法废标&quot;);
    }
    TenderNotice tenderNotice = tenderNoticeService.getById(abandonMoreVO.getNoticeId());
    if (ObjectUtils.isEmpty(tenderNotice)){
        throw new ParamValidateException(&quot;暂无招标数据，无法废标&quot;);
    }
}
</a:TemplateBody>
