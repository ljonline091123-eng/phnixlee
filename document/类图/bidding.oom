<o:Operation Id="o2412">
<a:ObjectID>9E99B59B-2E5E-4BCD-9DD7-935CC53064ED</a:ObjectID>
<a:Name>查询定标供应商数据列表（中标公示）
_getBiddingResult</a:Name>
<a:Code>getBiddingResult</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>List&lt;BiddingResultListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    //校验参数
    verifyData(noticeId, TenderNoticeStatusEnum.WINNING_BID.getState());

    List&lt;BiddingResult&gt; results = this.list(new LambdaQueryWrapper&lt;BiddingResult&gt;()
            .eq(BiddingResult::getNoticeId, noticeId)
            .orderByAsc(BiddingResult::getRank));
    List&lt;BiddingResultListVO&gt; resultVOList = BeanCopierUtil.copyList(results, BiddingResultListVO.class);



    return resultVOList;
}
</a:TemplateBody>
