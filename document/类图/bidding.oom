<o:Operation Id="o2188">
<a:ObjectID>66394B0F-5164-48C5-990B-0E0B72D1ECA1</a:ObjectID>
<a:Name>getTwiceTime</a:Name>
<a:Code>getTwiceTime</a:Code>
<a:CreationDate>1728719974</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728719974</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>String</a:ReturnType>
<a:TemplateBody>{
    BiddingInfo biddingInfo = this.getOne(new LambdaQueryWrapper&lt;BiddingInfo&gt;()
            .eq(BiddingInfo::getNoticeId, noticeId)
            .eq(BiddingInfo::getTwiceQuot, NumberConstant.ONE)
            .last(&quot;limit 1&quot;));
    if (!ObjectUtils.isEmpty(biddingInfo)){
        Date twiceTime = biddingInfo.getTwiceTime();
        return DateUtils.parseDateToStr(DateUtils.YYYY_MM_DD, twiceTime);
    }
    return null;
}
</a:TemplateBody>
