<a:TemplateBody>{
    IPage&lt;TenderNoticeListVO&gt; iPage = baseMapper.page(queryDTO.toMybatisPage(), queryDTO);
    return new PageResult&lt;&gt;(iPage);
}
</a:TemplateBody>
