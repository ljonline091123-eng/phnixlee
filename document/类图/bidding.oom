<o:Operation Id="o2827">
<a:ObjectID>64E2D3CC-BA36-4BF7-B974-19A9036D3B9B</a:ObjectID>
<a:Name>获取公告报名最新一条时间更改记录_getNoticeTimeNoticeChange</a:Name>
<a:Code>getNoticeTimeNoticeChange</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720008</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Comment>获取公告报名最新一条时间更改记录</a:Comment>
<a:ReturnType>TenderNoticeChangeRecord</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    return tenderNoticeChangeRecordService.getOne(new LambdaQueryWrapper&lt;TenderNoticeChangeRecord&gt;()
            .eq(TenderNoticeChangeRecord::getNoticeStatus, TenderNoticeStatusEnum.TENDER_NOTICE.getState())
            .eq(TenderNoticeChangeRecord::getNoticeId, noticeId)
            .eq(TenderNoticeChangeRecord::getType, NumberConstant.ONE)
            .orderByDesc(TenderNoticeChangeRecord::getCreateTime)
            .last(&quot;limit 1&quot;));
}
</a:TemplateBody>
