<c:Operations>
<o:Operation Id="o4206">
<a:ObjectID>1AFF9FBF-3576-45DF-A7F3-0A89D9F61471</a:ObjectID>
<a:Name>compareTo</a:Name>
<a:Code>compareTo</a:Code>
<a:CreationDate>1728719977</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728719977</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:ReturnType>int</a:ReturnType>
<a:TemplateBody>{
    if (this.getTotalScore().compareTo(o.getTotalScore()) &gt; 0) {
        return -1;
    } else if (this.getTotalScore().compareTo(o.getTotalScore()) &lt; 0) {
        return 1;
    } else {
        if (this.getNotTaxPrice().compareTo(o.getNotTaxPrice()) &gt; 0){
            return 1;
        } else if (this.getNotTaxPrice().compareTo(o.getNotTaxPrice()) &lt; 0){
            return -1;
        } else {
            return 0;
        }
    }
}
</a:TemplateBody>
<c:Parameters>
