<a:Name>fillField</a:Name>
<a:Code>fillField</a:Code>
<a:CreationDate>1728719974</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728719974</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    int rank = 0;
    for (CalibrationReportListVO calibratDataVO : calList) {
        rank++;
        calibratDataVO.setRank(rank);
        calibratDataVO.setCandidate(&quot;第&quot; + rank + &quot;中标候选人&quot;);
    }
}
</a:TemplateBody>
