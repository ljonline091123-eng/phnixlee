<c:Operations>
<o:Operation Id="o2588">
<a:ObjectID>8ABD37E3-9834-4980-9963-5B9E690237BD</a:ObjectID>
<a:Name>nextFlow</a:Name>
<a:Code>nextFlow</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728719975</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:ReturnType>Integer</a:ReturnType>
<a:TemplateBody>{
    int index = statusEnumList.indexOf(status);
    if (index == -1){
        throw new ParamValidateException(&quot;未查询到当前流程数据&quot;);
    }
    if (index + 1 &gt;= statusEnumList.size()){
        throw new ParamValidateException(&quot;未查询到下一流程数据&quot;);
    }

    return statusEnumList.get(index + 1);
}
</a:TemplateBody>
