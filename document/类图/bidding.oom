_getInfo</a:Name>
<a:Code>getInfo</a:Code>
<a:CreationDate>1728719981</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>ExpertInfoVO</a:ReturnType>
<a:TemplateBody>{
    Expert expert = this.getById(id);
    ExpertInfoVO vo = BeanCopierUtil.copyBean(expert, ExpertInfoVO.class);

    List&lt;AttachmentVO&gt; resumeAttachList = attachmentService.listAttachment(AttachmentTypeEnum.EXPERT_RESUME, expert.getId());
    vo.setResumeAttachList(resumeAttachList);
    return vo;
}
</a:TemplateBody>
