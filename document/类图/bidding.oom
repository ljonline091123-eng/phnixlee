<o:Operation Id="o2513">
<a:ObjectID>026AA78F-9C20-451F-96F3-A0B2D0B6BFFB</a:ObjectID>
<a:Name>获取专家评分记录
_getExpertEvalRecord</a:Name>
<a:Code>getExpertEvalRecord</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>List&lt;ExpertEvalRecordVO&gt;</a:ReturnType>
<a:TemplateBody>{
	//获取专家id
	Long expertId = getExpert(SecurityUtils.getUserId()).getId();
	//查询专家评分数据
	List&lt;ExpertScore&gt; expertScores = expertScoreService.list(new LambdaQueryWrapper&lt;ExpertScore&gt;()
			.eq(ExpertScore::getNoticeId, noticeId)
			.eq(ExpertScore::getVendorId, vendorId)
			.eq(ExpertScore::getExpertId, expertId)
			.orderByDesc(ExpertScore::getEvaTime));
	List&lt;ExpertEvalRecordVO&gt; recordList = BeanCopierUtil.copyList(expertScores, ExpertEvalRecordVO.class);
	return recordList;
}
</a:TemplateBody>
