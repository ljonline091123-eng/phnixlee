<o:Operation Id="o2320">
<a:ObjectID>1A0EEA55-5324-4E8D-9820-A3C12685CDE1</a:ObjectID>
<a:Name>判断依据 查他本身和二级单位_getTemplateListVOIPage</a:Name>
<a:Code>getTemplateListVOIPage</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720008</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Comment>判断依据 查他本身和二级单位</a:Comment>
<a:ReturnType>IPage&lt;BiddingMarkTemplateListVO&gt;</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    //查他本身和二级单位list
    List&lt;SysDept&gt; sysDeptList=remoteSystemService.getBySwitchListThridDeptId(&quot;1000000000&quot;, SecurityConstants.INNER);
    // 只保留公司
    List&lt;SysDept&gt; filterList = sysDeptList.stream()
            .filter(x -&gt; &quot;syncthird&quot;.equals(x.getOrigin()) &amp;&amp; !&quot;X&quot;.equals(x.getThridOrgType()) &amp;&amp; !&quot;BM&quot;.equals(x.getThridOrgType()))
            .collect(Collectors.toList());
    List&lt;String&gt; deptIdList=new ArrayList&lt;&gt;();
    filterList.stream().forEach(item -&gt; {
        deptIdList.add(item.getDeptId()+&quot;&quot;);
    });
    String[] deptId = Convert.toStrArray(String.join(&quot;,&quot;, deptIdList));
    pages = baseMapper.switchList(queryVO.toMybatisPage(),deptId,queryVO);
    System.out.println(pages);
    return pages;
}
</a:TemplateBody>
