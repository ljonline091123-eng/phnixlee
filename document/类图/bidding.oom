<o:Operation Id="o2504">
<a:ObjectID>438AA69E-BDC2-4B1B-BB5C-C33D460005F8</a:ObjectID>
<a:Name>根据方案id查询评分模板信息
_getMarkTempInfo</a:Name>
<a:Code>getMarkTempInfo</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>BiddingMarkTemplateDetailVO</a:ReturnType>
<a:TemplateBody>{
	//根据采购方案获取采购方案对应的招标信息
	ProcurementSchemeBidding schemeBidding = procurementSchemeBiddingService.getOne(new LambdaQueryWrapper&lt;ProcurementSchemeBidding&gt;()
			.eq(ProcurementSchemeBidding::getSchemeId, schemeId));
	ValidateUtils.isNullException(schemeBidding, &quot;该采购方案对应的招标信息不存在&quot;);
	//获取评分模板id
	Long evaluationTemplateId = schemeBidding.getEvaluationTemplateId();
	BiddingMarkTemplateDetailVO templateDetailVO = biddingMarkTemplateService.detail(evaluationTemplateId);
	return templateDetailVO;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o2505">
<a:ObjectID>F69FACA0-B7AC-4729-898B-43A7B56BD5AC</a:ObjectID>
