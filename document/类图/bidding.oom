<a:Name>门户端-中标公示列表分页-分页
_selectVendorPortalPublicityPage</a:Name>
<a:Code>selectVendorPortalPublicityPage</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>PageResult&lt;VendorPortalPublicityListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    IPage&lt;VendorPortalPublicityListVO&gt; iPage = baseMapper.findVendorPortalPublicityPage(queryDTO.toMybatisPage(), queryDTO);
    Date nowDate = DateUtils.getNowDate();
    for (VendorPortalPublicityListVO record : iPage.getRecords()) {
        if (nowDate.after(record.getPublicityEndTime())){
            record.setPublicityStatus(2);
        } else {
            record.setPublicityStatus(1);
        }

        record.setMinProjectName(getMinProjectName(record.getSchemeId()));
    }
    return new PageResult&lt;&gt;(iPage);
}
</a:TemplateBody>
