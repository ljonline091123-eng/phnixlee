<c:Operations>
<o:Operation Id="o1176">
<a:ObjectID>C297DD55-CE93-401F-8E11-80F711532A11</a:ObjectID>
<a:Name>根据编码查询枚举
_getValueByCode</a:Name>
<a:Code>getValueByCode</a:Code>
<a:CreationDate>1728719972</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720008</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Comment>根据编码查询枚举
</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    if (Objects.isNull(state)) {
        return null;
    }
    for (TenderNoticeStatusEnum typeEnum : values()) {
        if (typeEnum.state.equals(state)) {
            return typeEnum.getDesc();
        }
    }
    return null;
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,67={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,9=@return


</a:ExtendedAttributesText>
