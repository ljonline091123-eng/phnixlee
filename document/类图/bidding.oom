<o:Operation Id="o2467">
<a:ObjectID>FB47CD19-E0B4-4534-A72A-977DF02AF1E1</a:ObjectID>
<a:Name>查询采购方案评分模板关联关系信息
_detail</a:Name>
<a:Code>detail</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>BiddingSchemaTemplateDetailVO</a:ReturnType>
<a:TemplateBody>{
    BiddingSchemaTemplate schemaTemplate = this.getOne(new LambdaQueryWrapper&lt;BiddingSchemaTemplate&gt;()
            .eq(BiddingSchemaTemplate::getSchemeId, schemeId));
    BiddingSchemaTemplateDetailVO vo = BeanCopierUtil.copyBean(schemaTemplate, BiddingSchemaTemplateDetailVO.class);
    BiddingMarkTemplate markTemplate = biddingMarkTemplateService.getById(schemaTemplate.getTemplateId());
    vo.setTemplateName(markTemplate.getName());
    return vo;
}
</a:TemplateBody>
