<o:Operation Id="o2204">
<a:ObjectID>CEC1E427-C353-4645-BC21-03C91B721639</a:ObjectID>
<a:Name>获取采购方案的投标供应商信息_listBiddingVendor</a:Name>
<a:Code>listBiddingVendor</a:Code>
<a:CreationDate>1728719974</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>List&lt;BiddingVendorVO&gt;</a:ReturnType>
<a:TemplateBody>{
    return super.list(new LambdaQueryWrapper&lt;BiddingInfo&gt;()
            .eq(BiddingInfo::getSchemeId,schemeId)
            .eq(BiddingInfo::getBiddingStatus,1))
            .stream()
            .collect(Collectors.groupingBy(BiddingInfo::getVendorId))
            .values().stream()
            .map(info -&gt; BeanCopierUtil.copyBean(info, BiddingVendorVO.class))
            .collect(Collectors.toList());
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o2205">
<a:ObjectID>7D429BD2-559E-472B-9C43-C0489BEEE23A</a:ObjectID>
<a:Name>schemeId</a:Name>
<a:Code>schemeId</a:Code>
