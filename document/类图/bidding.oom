<a:ModificationDate>1728719975</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    String businessId = variables.get(&quot;businessId&quot;).toString();
    Integer nextNoticeStatus = findNextTenderNoticeStatus(Long.valueOf(businessId));
    tenderNoticeService.updateStatus(Long.valueOf(businessId), nextNoticeStatus);
}
