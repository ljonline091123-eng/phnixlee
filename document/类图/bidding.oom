<a:Name>修改启用状态
_updateStatus</a:Name>
<a:Code>updateStatus</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>boolean</a:ReturnType>
<a:TemplateBody>{
    LambdaUpdateWrapper&lt;BiddingMarkTemplate&gt; updateWrapper = new LambdaUpdateWrapper&lt;&gt;();
    updateWrapper.set(BiddingMarkTemplate::getState, state);
    updateWrapper.eq(BiddingMarkTemplate::getId, id);
    return update(updateWrapper);
}
</a:TemplateBody>
