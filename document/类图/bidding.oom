<a:TemplateBody>{
    //验证状态
    TenderNotice tenderNotice = tenderNoticeService.getById(noticeId);
    if (tenderNotice.getNoticeStatus().compareTo(noticeState) &lt; 0){
        throw new ParamValidateException(&quot;当前公告状态无法查询相关数据&quot;);
    }
}
