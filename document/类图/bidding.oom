<o:Operation Id="o2738">
<a:ObjectID>6C615BE8-2DE0-4EED-8833-2477BA9336F8</a:ObjectID>
<a:Name>重新发布招标公告
_aNewAdd</a:Name>
<a:Code>aNewAdd</a:Code>
<a:CreationDate>1728719975</a:CreationDate>
<a:Creator>13715</a:Creator>
<a:ModificationDate>1728720186</a:ModificationDate>
<a:Modifier>13715</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>boolean</a:ReturnType>
<a:TemplateBody>{
    Integer schemeType = tenderNoticeVO.getSchemeType();
    verifyNewAddParam(tenderNoticeVO);
    //删除旧招标公告数据
    this.remove(new LambdaUpdateWrapper&lt;TenderNotice&gt;()
            .eq(TenderNotice::getSchemeId, tenderNoticeVO.getSchemeId()));
    if(schemeType == NumberConstant.ONE)
        return this.addNotice(tenderNoticeVO);
    else
        return this.add(tenderNoticeVO);
}
</a:TemplateBody>
