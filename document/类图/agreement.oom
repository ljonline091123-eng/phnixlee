<a:Comment>设置保证金</a:Comment>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    if (procurementScheme != null &amp;&amp; procurementScheme.getIsReceiveDeposit() != 1) {
        procurementScheme.setSecurityDeposit(null);
        procurementScheme.setFinanceConfirmId(null);
        procurementScheme.setFinanceConfirmName(null);
    }
}
