<a:ObjectID>ECD873ED-1AB0-45F6-BCBC-04B5D0B62178</a:ObjectID>
<a:Name>获取供应商列表/listVendor</a:Name>
<a:Code>获取供应商列表listVendor</a:Code>
<a:CreationDate>1728697640</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728705981</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Comment>获取供应商列表
</a:Comment>
<a:ReturnType>PageResult&lt;VendorVO&gt;</a:ReturnType>
<a:TemplateBody>{
    return vendorService.listVendorJkptht(queryVO);
}
</a:TemplateBody>
