<o:Operation Id="o3831">
<a:ObjectID>9D5F98B2-CC47-467B-B79C-30D2FDF8B203</a:ObjectID>
<a:Name>根据合约拆分记录获取合约规划信息/listProcurementContractPlanByContractSplit</a:Name>
<a:Code>根据合约拆分记录获取合约规划信息listProcurementContractPlanByContractSplit</a:Code>
<a:CreationDate>1728697638</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728703432</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>List&lt;ProcurementContractPlanListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    /* 合约规划拆分对象 */
    List&lt;ContractPlanningSplit&gt; planningSplits = contractPlanningSplitService.listByIds(contractSplitIds);
    /* 采购计划 id */
    List&lt;Long&gt; planIdList = planningSplits.stream()
            .map(ContractPlanningSplit::getProcurementPlanId)
            .distinct().collect(Collectors.toList());

    return baseMapper.selectProcurementContractPlanningList(planIdList);
}
</a:TemplateBody>
<c:Parameters>
