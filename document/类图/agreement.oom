<o:Operation Id="o7274">
<a:ObjectID>208C22EF-D548-43D3-9CE2-65C7EA73C419</a:ObjectID>
<a:Name>根据登录用户id获取供应商联系人/getVendorContactByLoginUser</a:Name>
<a:Code>根据登录用户id获取供应商联系人getVendorContactByLoginUser</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706783</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>VendorContact</a:ReturnType>
<a:TemplateBody>{
    List&lt;VendorContact&gt; list = super.list(new LambdaQueryWrapper&lt;VendorContact&gt;()
            .eq(VendorContact::getLoginUserId,userId));
    if (CollectionUtil.isEmpty(list)) {
        log.error(&quot;loginUserId[{}]对应的企业联系人不存在..&quot;,userId);
        throw new NotFoundException(&quot;获取当前用户失败&quot;);
    }
    if (list.size() &gt; 1) {
        throw new BusinessException(&quot;该登录用户对应了多个联系人，请确认&quot;);
    }

    return list.get(0);
}
</a:TemplateBody>
<c:Parameters>
