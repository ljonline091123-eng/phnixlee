<o:Operation Id="o7472">
<a:ObjectID>B346AA51-C817-4474-B1D8-4FC5088F5EF1</a:ObjectID>
<a:Name>获取供应商履约评价/listVendorPerformance</a:Name>
<a:Code>获取供应商履约评价listVendorPerformance</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706535</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>List&lt;VendorPerformanceListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    Vendor vendor = super.getById(id);
    ValidateUtils.isNullException(vendor,&quot;该供应商不存在&quot;);

    List&lt;VendorPerformanceEvaluation&gt; performanceEvaluations =  vendorPerformanceEvaluationService.getAndSyncVendorPerformanceList(id);
    if (CollectionUtil.isNotEmpty(performanceEvaluations)) {
        return performanceEvaluations.stream()
                .map(VendorPerformanceListVO::new)
                .collect(Collectors.toList());
    }
    return Collections.emptyList();
}
</a:TemplateBody>
