<o:Operation Id="o1164">
<a:ObjectID>DDDB9163-62F2-4E26-9DEC-EF298CFBE24E</a:ObjectID>
<a:Name>保存合同结算与付款节点信息/saveAgreementPaymentList</a:Name>
<a:Code>保存合同结算与付款节点信息saveAgreementPaymentList</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704453</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    if (CollectionUtil.isNotEmpty(agreementPaymentLists)) {
        for (AgreementPaymentList paymentList : agreementPaymentLists) {
            paymentList.setAgreementId(agreementId);
        }
        super.saveBatch(agreementPaymentLists);
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1165">
<a:ObjectID>0D7A4605-D65D-4797-B20B-ACAA63133010</a:ObjectID>
