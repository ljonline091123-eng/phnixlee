<o:Operation Id="o4132">
<a:ObjectID>C9B3CDE2-A399-4807-A606-BBBE4E825978</a:ObjectID>
<a:Name>保存对应关系/saveRelate</a:Name>
<a:Code>保存对应关系saveRelate</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728703582</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    List&lt;ContractPlanningSplit&gt; planningSplits = contractPlanningSplitService.listByIds(contractSplitId);
    for (ContractPlanningSplit planningSplit : planningSplits) {
        ProcurementSchemePlanRelate planRelate = new ProcurementSchemePlanRelate();
        planRelate.setProcurementPlanId(planningSplit.getProcurementPlanId());
        planRelate.setContractSplitId(planningSplit.getId());
        planRelate.setProcurementSchemeId(schemeId);

        baseMapper.insert(planRelate);
    }
}
</a:TemplateBody>
