<a:Name>根据登录用户获取其对应供应商/getByLoginUser</a:Name>
<a:Code>根据登录用户获取其对应供应商getByLoginUser</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706535</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Comment> todo 这里需要使用缓存</a:Comment>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>Vendor</a:ReturnType>
<a:TemplateBody>{
    VendorContact vendorContact = vendorContactService.getVendorContactByLoginUser(userId);
    Vendor vendor = super.getById(vendorContact.getVendorId());
    return Optional.of(vendor).orElseThrow(() -&gt; new ParamValidateException(&quot;用户对应的供应商信息不存在&quot;));
}
