<o:Operation Id="o4038">
<a:ObjectID>5C799CC1-6686-4499-B7FC-A61DAA8C8068</a:ObjectID>
<a:Name>保存采购计划/saveProcurementPlan</a:Name>
<a:Code>保存采购计划saveProcurementPlan</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728701703</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>Long</a:ReturnType>
<a:TemplateBody>{
    checkMaterialsList(requestVO);
    if (NumberUtil.isNullOrZero(requestVO.getProcurementPlan().getId())) {
        // 新增
        addProcurementPlan(requestVO);
    } else {
        // 修改
        updateProcurementPlan(requestVO);
    }

    return requestVO.getProcurementPlan().getId();
}
</a:TemplateBody>
