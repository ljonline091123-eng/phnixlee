<a:Name>获取供应商主要联系人/getMainContact</a:Name>
<a:Code>获取供应商主要联系人getMainContact</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706783</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>VendorMainContactVO</a:ReturnType>
<a:TemplateBody>{
    VendorContact vendorContact = this.getOne(new LambdaQueryWrapper&lt;VendorContact&gt;()
            .eq(VendorContact::getVendorId,vendorId)
            .eq(VendorContact::getIsMainContact,1));
    return BeanCopierUtil.copyBean(vendorContact,VendorMainContactVO.class);
}
</a:TemplateBody>
