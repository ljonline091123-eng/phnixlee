<a:TemplateBody>{
    // todo 加校验

    super.update(new LambdaUpdateWrapper&lt;Vendor&gt;()
            .set(Vendor::getIsBlack,requestVO.getBlackState())
            .set(Vendor::getBlackBeginDate,null)
            .set(Vendor::getBlackEndDate,null)
