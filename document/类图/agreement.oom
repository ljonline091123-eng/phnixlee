<o:Operation Id="o1239">
<a:ObjectID>EC82A013-14CE-41C8-B80F-CEB5101D7E06</a:ObjectID>
<a:Name>合同列表查询/listPage</a:Name>
<a:Code>合同列表查询listPage</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704235</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>PageResult&lt;AgreementListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    IPage&lt;AgreementListVO&gt; ipage = baseMapper.selectPageList(queryVO.toMybatisPage(),queryVO);
    for (AgreementListVO agreement : ipage.getRecords()) {
        agreement.setIsOperate(getAgreementIsOperate(agreement.getAgreementState(),agreement.getCreateById(),agreement.getSignatureUserId()));
    }
    return new PageResult&lt;&gt;(ipage);
}
</a:TemplateBody>
