<o:Operation Id="o4170">
<a:ObjectID>AA7FF885-5215-4653-BC95-A8AB4ACD36B0</a:ObjectID>
<a:Name>采购方案列表查询/listPage</a:Name>
<a:Code>采购方案列表查询listPage</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728701188</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>PageResult&lt;ProcurementSchemeListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    // ToDo 获取当前登录用户，判断是否为领导，如果是领导则可以看到所有
    queryVO.setIsLeader(0);
    queryVO.setProcurementOfficer(SecurityUtils.getUserId());
    IPage&lt;ProcurementSchemeListVO&gt; iPage = baseMapper.selectPageList(queryVO.toMybatisPage(), queryVO);

    return new PageResult&lt;&gt;(iPage);
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o4171">
<a:ObjectID>E501904A-36F7-4D9C-A828-E642A5976BB8</a:ObjectID>
