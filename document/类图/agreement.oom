<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706535</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>String</a:ReturnType>
<a:TemplateBody>{
    Vendor vendor = super.getOne(new LambdaQueryWrapper&lt;Vendor&gt;()
            .eq(Vendor::getEnterpriseName,enterpriseName));
    if (vendor != null) {
        VendorMainContactVO mainContact = vendorContactService.getMainContact(vendor.getId());
        return &quot;企业名称已存在，请联系 &quot; + mainContact.getContactName() + &quot;-&quot; + mainContact.getContactPhone();
    }
    return &quot;成功&quot;;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o7481">
<a:ObjectID>8FBECECA-68CA-4666-B536-A488D43C7F12</a:ObjectID>
<a:Name>enterpriseName</a:Name>
<a:Code>enterpriseName</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697642</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
<c:InfluentObject>
<o:Shortcut Ref="o7482"/>
</c:InfluentObject>
<c:Annotations>
<o:Annotation Id="o7483">
<a:ObjectID>0EE439C0-902C-4186-8709-005754DB491D</a:ObjectID>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697642</a:ModificationDate>
