<o:Operation Id="o1340">
<a:ObjectID>08F06F07-E64C-4634-A61D-7053BC4FAC32</a:ObjectID>
<a:Name>校验合同供应商确认是否成功/checkAgreementAffirmState</a:Name>
<a:Code>校验合同供应商确认是否成功checkAgreementAffirmState</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704235</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>Boolean</a:ReturnType>
<a:TemplateBody>{
    Agreement agreement = this.getById(id);
    return NumberUtil.isNotNullAndZero(agreement.getConvertPdfAttachmentId())
            &amp;&amp; AgreementStateEnum.PUSH_SIGNATURE_PLATFORM.equalsState(agreement.getAgreementState());
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1341">
<a:ObjectID>4271395D-ACA0-40B2-B282-14E0DD47AC6A</a:ObjectID>
