<o:Operation Id="o7077">
<a:ObjectID>928AEDD1-7F63-40E3-B3A5-4B190A70A14C</a:ObjectID>
<a:Name>审批通过后将黑名单信息更新/handleApprove</a:Name>
<a:Code>审批通过后将黑名单信息更新handleApprove</a:Code>
<a:CreationDate>1728697641</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728708249</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Comment>审批通过后将黑名单信息更新</a:Comment>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    // 更新企业信息
    vendorService.update(new LambdaUpdateWrapper&lt;Vendor&gt;()
            .set(Vendor::getIsBlack,vendorChange.getIsBlack())
            .set(Vendor::getBlackBeginDate,vendorChange.getBlackBeginDate())
            .set(Vendor::getBlackEndDate,vendorChange.getBlackEndDate())
            .set(Vendor::getState,VendorStateEnum.APPROVE.getState())
            .set(Vendor::getWfProcessId,vendorChange.getWfProcessId())
            .eq(Vendor::getId,vendorChange.getVendorId()));
}
</a:TemplateBody>
