<a:Code>extractDistinctValues</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697639</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:ReturnType>List&lt;R&gt;</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    return list.stream()
            .map(mapper)
            .distinct()
            .collect(Collectors.toList());
}
</a:TemplateBody>
