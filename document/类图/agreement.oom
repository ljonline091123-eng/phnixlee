<o:Operation Id="o3994">
<a:ObjectID>993461BB-1A9C-4DE3-9D52-358D345897C0</a:ObjectID>
<a:Name>根据最小核算项目编码获取最小核算项目/getMinProjectByMinAccountCode</a:Name>
<a:Code>根据最小核算项目编码获取最小核算项目getMinProjectByMinAccountCode</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728703619</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>MinProjectVO</a:ReturnType>
<a:TemplateBody>{
    if(StringUtils.isBlank(projectCode)) {
        throw new ParamValidateException(&quot;最小核酸项目编码不能为空&quot;);
    }

    MinProjectDetailResponseDTO detailResponseDTO = contractPlanService.getMinProjectDetail(projectCode);
    // 保存项目信息
    MinProject minProject = this.saveMinProject(detailResponseDTO);

    MinProjectVO minProjectVO =  BeanCopierUtil.copyBean(minProject,MinProjectVO.class);
    if (StringUtils.isBlank(minProjectVO.getManagementOrgId())) {
        throw new ParamValidateException(&quot;该项目所归属管理组织为空，请确认&quot;);
    }

    // 获取我们系统里面对应的机构 id
    SysDept sysDept = remoteSystemService.getByThridDeptId(minProjectVO.getManagementOrgId(), SecurityConstants.INNER);
    ValidateUtils.isNullException(sysDept,&quot;该项目所归属管理组织对应的组织机构不存在，请确认&quot;);
    minProjectVO.setDeptId(sysDept.getDeptId());
    return minProjectVO;
}
</a:TemplateBody>
