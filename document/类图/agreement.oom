<o:Operation Id="o7165">
<a:ObjectID>A737E011-EA17-4B66-B975-C7972B97E558</a:ObjectID>
<a:Name>获取最新审批通过的变更id/getLastChangeId</a:Name>
<a:Code>获取最新审批通过的变更idgetLastChangeId</a:Code>
<a:CreationDate>1728697641</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706415</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>Long</a:ReturnType>
<a:TemplateBody>{
    // 根据供应商id在供应商变更表中查找最后一次变更信息
    List&lt;VendorChange&gt; vendorChangeList = super.list(new LambdaQueryWrapper&lt;VendorChange&gt;()
            .eq(VendorChange::getVendorId, id)
            .eq(VendorChange::getChangeStatus, VendorStateEnum.APPROVE.getState())
            .orderByDesc(VendorChange::getVersion));
    // 不存在变更版本时，创建一份VO版本
    if (!CollectionUtils.isEmpty(vendorChangeList)) {
        return vendorChangeList.get(0).getId();
    }
    return null;
}
</a:TemplateBody>
