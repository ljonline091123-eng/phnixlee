<o:Operation Id="o1114">
<a:ObjectID>956458C5-6033-418A-B187-D5002ED4001C</a:ObjectID>
<a:Name>保存合同清单/saveAgreementMaterialsList</a:Name>
<a:Code>保存合同清单saveAgreementMaterialsList</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704325</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    if (CollectionUtil.isNotEmpty(agreementMaterialsLists)) {
        for (AgreementMaterialsList agreementMaterialsList : agreementMaterialsLists) {
            agreementMaterialsList.setAgreementId(agreementId);
        }
        super.saveBatch(agreementMaterialsLists);
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1115">
<a:ObjectID>C380ABFA-5B49-4FF7-9E16-4BF4AD337234</a:ObjectID>
