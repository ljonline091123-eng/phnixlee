<o:Operation Id="o4110">
<a:ObjectID>6FD90B22-5634-4EF4-942D-874F1BD6DE3E</a:ObjectID>
<a:Name>修改采购方案 - 招标信息/updateProcurementSchemeBidding</a:Name>
<a:Code>修改采购方案招标信息updateProcurementSchemeBidding</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728703498</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    if (NumberUtil.isNullOrZero(procurementSchemeBidding.getId())) {
        throw new ParamValidateException(&quot;采购方案编辑时，需要传招标文件 id&quot;);
    }
    procurementSchemeBidding.setSchemeId(schemeId);
    super.updateById(procurementSchemeBidding);

    attachmentService.updateBusiness(procurementSchemeBidding.getBiddingAttachmentId(), AttachmentTypeEnum.SCHEME_BIDDING,procurementSchemeBidding.getSchemeId());
}
</a:TemplateBody>
<c:Parameters>
