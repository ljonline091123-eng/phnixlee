<o:Operation Id="o5955">
<a:ObjectID>299F83AC-8839-4DB3-9135-F35B66D86B5E</a:ObjectID>
<a:Name>获取企业资质列表/listCertification</a:Name>
<a:Code>获取企业资质列表listCertification</a:Code>
<a:CreationDate>1728697640</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728705898</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Comment>获取企业资质列表
</a:Comment>
<a:ReturnType>ResultData&lt;VendorCertificationListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    Vendor vendor = vendorService.getByLoginUser(SecurityUtils.getUserId());

    // 获取主要联系人
    VendorMainContactVO mainContact = vendorContactService.getMainContact(vendor.getId());

    return ResultData.data(vendorCertificationService.listCertification(vendor.getId(),mainContact.getId()));
}
</a:TemplateBody>
