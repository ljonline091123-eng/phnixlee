     VendorOperateLog operateLog = new VendorOperateLog();
     operateLog.setVendorId(vendorId);
     operateLog.setBusinessCode(businessCode.getBusinessCode());
     operateLog.setState(0);

     super.save(operateLog);
     return operateLog.getId();
}
