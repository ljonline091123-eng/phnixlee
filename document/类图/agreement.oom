<o:Operation Id="o1280">
<a:ObjectID>7DA423CC-36AE-43AA-8D05-9580832D6824</a:ObjectID>
<a:Name>获取合同的附件id/getAgreementAttachmentId</a:Name>
<a:Code>获取合同的附件idgetAgreementAttachmentId</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704235</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>AgreementFileVO</a:ReturnType>
<a:TemplateBody>{
    Agreement agreement = this.getById(id);
    ValidateUtils.isNullException(agreement,&quot;该合同不存在&quot;);
    long attachmentId = 0L;
    String message = &quot;获取成功&quot;;
    if (NumberUtil.isNotNullAndZero(agreement.getWatermarkAttachmentId())) {
        attachmentId = agreement.getWatermarkAttachmentId();
    }else if (NumberUtil.isNotNullAndZero(agreement.getLabelAttachmentId())) {
        attachmentId = agreement.getLabelAttachmentId();
    } else {
        message = &quot;合同附件正在生成中，请稍后再查看&quot;;
    }

    return new AgreementFileVO(attachmentId,message);
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1281">
<a:ObjectID>53AD44B4-33BC-4622-A052-D70633F0A921</a:ObjectID>
