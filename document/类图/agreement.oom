<o:Operation Id="o4194">
<a:ObjectID>F94F9883-12F0-4F14-82EB-2200003B8685</a:ObjectID>
<a:Name>获取采购方案的物料清单/listMaterials</a:Name>
<a:Code>获取采购方案的物料清单listMaterials</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728701423</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>List&lt;MaterialsVO&gt;</a:ReturnType>
<a:TemplateBody>{
    List&lt;ProcurementSchemePlanRelate&gt; relateList = procurementSchemePlanRelateService.listBySchemeId(id);
    List&lt;Long&gt; planIdList = relateList.stream()
            .map(ProcurementSchemePlanRelate::getProcurementPlanId)
            .collect(Collectors.toList());

    List&lt;MaterialsList&gt; materialsLists = materialsListService.listMaterialsListByPlanIds(planIdList);
    //将相同的物料进行合并
    Map&lt;String, MaterialsList&gt; materialsListMap = new HashMap&lt;&gt;();
    MaterialsList materials;
    for (MaterialsList materialsList : materialsLists) {
        materials = materialsListMap.get(materialsList.getMaterialsCode());
        if (materials != null) {
            materials.setCount(materials.getCount().add(materialsList.getCount()));
            materialsListMap.put(materialsList.getMaterialsCode(), materials);
        } else {
            materialsListMap.put(materialsList.getMaterialsCode(), materialsList);
        }
    }

    return BeanCopierUtil.copyList(new ArrayList&lt;&gt;(materialsListMap.values()), MaterialsVO.class);
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o4195">
<a:ObjectID>4FACC398-6C01-4E52-8604-7B5A87BAF33C</a:ObjectID>
<a:Name>id</a:Name>
<a:Code>id</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697639</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
