<o:Operation Id="o7291">
<a:ObjectID>88E92983-00E7-48BE-A920-9B452E21B4EA</a:ObjectID>
<a:Name>增加登录账号/addLoginUser</a:Name>
<a:Code>增加登录账号addLoginUser</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706783</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>Long</a:ReturnType>
<a:TemplateBody>{
    BusinessUser businessUser = new BusinessUser();
    businessUser.setUserName(contactPhone);
    businessUser.setNickName(contactName);
    businessUser.setUserType(UserTypeEnum.VENDOR);
    R&lt;Long&gt; r = remoteUserService.addBusinessUser(businessUser, SecurityConstants.INNER);

    if (R.SUCCESS != r.getCode()) {
        throw new BusinessException(r.getMsg());
    }

    return r.getData();
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o7292">
<a:ObjectID>0131D2BD-E189-45FE-9E74-9EA6912F7CEF</a:ObjectID>
