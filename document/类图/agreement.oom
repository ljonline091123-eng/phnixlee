<a:ObjectID>B78DA879-B9E9-49AC-B036-BD761291C5A1</a:ObjectID>
<a:Name>获取采购计划编码/getProcurementPlanCode</a:Name>
<a:Code>获取采购计划编码getProcurementPlanCode</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728705566</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Comment>获取采购计划编码</a:Comment>
<a:ReturnType>String</a:ReturnType>
