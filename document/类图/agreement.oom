<a:ObjectID>D169BEDA-A70D-43B7-99DA-61F1D08C8D04</a:ObjectID>
<a:Name>recursionFnTree</a:Name>
<a:Code>recursionFnTree</a:Code>
<a:CreationDate>1728697641</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697641</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    List&lt;VendorClassifyTreeVO&gt; childList;
    for (VendorClassifyTreeVO treeNode : rootList) {
        childList = treeNodeMap.get(treeNode.getId().toString());
        if (CollectionUtil.isNotEmpty(childList)) {
            treeNode.setChildren(childList);

            recursionFnTree(childList, treeNodeMap);
        }
    }
}
</a:TemplateBody>
