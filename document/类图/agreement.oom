<o:Operation Id="o4068">
<a:ObjectID>9BC446E5-CC7C-41C6-A2AC-E7270FE53FAC</a:ObjectID>
<a:Name>推送采购计划/pushProcurementPlan</a:Name>
<a:Code>推送采购计划pushProcurementPlan</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728701703</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    //设置第三方数据合约规划推送记录
    savaContractPlanningPushRecord(planPushVO);
    //调第三方接口，生成采购计划的待办信息
    dealOpenPeopleTodoTask(planPushVO);
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o4069">
<a:ObjectID>FE83E49D-2192-4F33-9FCA-D8591C195D94</a:ObjectID>
