<o:Operation Id="o7238">
<a:ObjectID>D45B47A6-FF92-413E-9E7A-D80764DBCBE4</a:ObjectID>
<a:Name>保存供应商主要联系人/saveMainVendorContact</a:Name>
<a:Code>保存供应商主要联系人saveMainVendorContact</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706783</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>Long</a:ReturnType>
<a:TemplateBody>{
    //为主要联系人
    contact.setIsMainContact(1);
    contact.setState(VendorContactStateEnum.VALID.getState());

    // 校验联系人
    checkVendorContact(contact);

    // 只有一个主要联系人
    VendorContact mainContact = this.getOne(new LambdaQueryWrapper&lt;VendorContact&gt;()
            .eq(VendorContact::getVendorId,contact.getVendorId())
            .eq(VendorContact::getIsMainContact,1));
    if (mainContact != null) {
        contact.setId(mainContact.getId());
    }

    super.saveOrUpdate(contact);
    return contact.getId();
}
</a:TemplateBody>
<c:Parameters>
