<o:Operation Id="o7349">
<a:ObjectID>F1116315-83EE-4F8D-A178-A52AD373803D</a:ObjectID>
<a:Name>获取供应商合作记录/listPage</a:Name>
<a:Code>获取供应商合作记录listPage</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706870</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>PageResult&lt;VendorCooperationListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    IPage&lt;VendorCooperationListVO&gt; page = vendorCooperationMapper.selectVendorCooperationList(queryVO.toMybatisPage(),queryVO);
    page.getRecords().forEach(x -&gt; {
        if (x.getCooperationAmount() == null) {
            x.setCooperationAmount(BigDecimal.ZERO);
        }

        if (x.getExcellentNum() == null) {
            x.setExcellentNum(0L);
        }
    });
    return new PageResult&lt;&gt;(page);
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o7350">
<a:ObjectID>00EB3D88-D657-436C-80C6-CB2AE1F640BF</a:ObjectID>
