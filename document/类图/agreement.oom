<o:Operation Id="o1255">
<a:ObjectID>963D5943-50E3-4E9C-A68B-D628428BF5BD</a:ObjectID>
<a:Name>保存合同/saveAgreement</a:Name>
<a:Code>保存合同saveAgreement</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704235</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>AgreementSaveVO</a:ReturnType>
<a:TemplateBody>{
    AgreementSaveVO agreementSave;

    // 校验清单数据
    checkSaveAgreementMaterialsList(requestVO.getAgreementMaterialsLists(),requestVO.getAgreement().getSchemeId(),requestVO.getAgreement().getContractSplitId(),
            requestVO.getAgreement().getVendorId());

    if (NumberUtil.isNullOrZero(requestVO.getAgreement().getId())) {
        agreementSave = addAgreement(requestVO);
    } else {
        agreementSave = updateAgreement(requestVO);
    }

    return agreementSave;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1256">
<a:ObjectID>59CA129B-3BF7-4F51-BC07-D8595BE63972</a:ObjectID>
<a:Name>requestVO</a:Name>
<a:Code>requestVO</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697635</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Parameter.DataType>AgreementSaveRequestVO</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
<c:InfluentObject>
<o:Shortcut Ref="o1257"/>
</c:InfluentObject>
<c:Annotations>
<o:Annotation Id="o1258">
<a:ObjectID>2C55FDE6-7087-4247-BBE6-6F53B69B2BF0</a:ObjectID>
<a:CreationDate>1728697635</a:CreationDate>
