<a:ObjectID>5B408DD3-DAE4-4040-8CD5-F8EFD8B58DD8</a:ObjectID>
<a:Name>获取采购方案编码/getProcurementSchemeCode</a:Name>
<a:Code>获取采购方案编码getProcurementSchemeCode</a:Code>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728705217</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Comment>获取采购方案编码
</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    return &quot;CGRW&quot; + LocalDate.now().getYear() + businessCodeService.getBusinessCode(BusinessCodeEnum.PROCUREMENT_SCHEME);
}
