<a:Name>getPriceTypeText</a:Name>
<a:Code>getPriceTypeText</a:Code>
<a:CreationDate>1728697640</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697640</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:ReturnType>String</a:ReturnType>
<a:TemplateBody>{
    if (PriceTypeEnum.FLOAT_PRICE.equalsType(this.getPriceType())) {
        this.priceTypeText = &quot;浮动价&quot;;
    } else {
        this.priceTypeText = &quot;/&quot;;
    }
    return priceTypeText;
}
</a:TemplateBody>
</o:Operation>
