<a:ModificationDate>1728697635</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Parameter.DataType>List&lt;AgreementMaterialsList&gt;</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o1116">
<a:ObjectID>BFCDAD20-F7D7-478B-8F4D-4E8AF946C234</a:ObjectID>
<a:Name>agreementId</a:Name>
<a:Code>agreementId</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697635</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
