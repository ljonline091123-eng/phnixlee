<a:ModificationDate>1728697639</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Parameter.DataType>ProcurementPlanPushVO</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
<c:InfluentObject>
<o:Shortcut Ref="o4070"/>
</c:InfluentObject>
<c:Annotations>
<o:Annotation Id="o4071">
<a:ObjectID>A21580AA-9E15-4219-A77E-9BD83B98DB12</a:ObjectID>
<a:CreationDate>1728697639</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697639</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
