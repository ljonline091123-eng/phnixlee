<o:Operation Id="o7063">
<a:ObjectID>CD061E13-7DA1-4108-BD99-73C9DD8E8225</a:ObjectID>
<a:Name>保存供应商黑名单变更信息/saveVendorBlack</a:Name>
<a:Code>保存供应商黑名单变更信息saveVendorBlack</a:Code>
<a:CreationDate>1728697641</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728707022</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Comment>保存供应商黑名单信息</a:Comment>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    Vendor vendor = vendorService.getById(requestVO.getId());
    ValidateUtils.isNullException(vendor,&quot;该供应商不存在&quot;);

    if (requestVO.getBlackState() == 1) {
        // 移入黑名单
        addVendorToBlack(requestVO);
    } else {
        // 移除黑名单
        addVendorFromBlack(requestVO);
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o7064">
<a:ObjectID>64695F8A-4041-4EFC-9711-1B0B52EDA6AC</a:ObjectID>
<a:Name>requestVO</a:Name>
<a:Code>requestVO</a:Code>
<a:CreationDate>1728697641</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697641</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Parameter.DataType>VendorBlackRequestVO</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
<c:InfluentObject>
<o:Shortcut Ref="o7065"/>
</c:InfluentObject>
<c:Annotations>
<o:Annotation Id="o7066">
<a:ObjectID>96A5D8B8-FC3F-42E6-BEE7-610BF418734E</a:ObjectID>
