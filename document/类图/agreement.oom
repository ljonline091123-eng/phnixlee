<a:ObjectID>AA8CDCE5-EFFD-4A7D-A932-50FB6DE0145C</a:ObjectID>
<a:Name>保存合同款项信息/saveAgreementPaymentItem</a:Name>
<a:Code>保存合同款项信息saveAgreementPaymentItem</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704513</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    if (agreementPaymentItem == null) {
        throw new BusinessException(&quot;合同款项信息不能为空&quot;);
    }

    agreementPaymentItem.setAgreementId(agreementId);
    super.save(agreementPaymentItem);
}
</a:TemplateBody>
