    super.update(new LambdaUpdateWrapper&lt;ProcurementScheme&gt;()
            .set(ProcurementScheme::getState, ProcurementSchemeStateEnum.REVOKED.getState())
            .eq(ProcurementScheme::getId, businessId));
}
</a:TemplateBody>
