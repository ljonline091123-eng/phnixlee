<o:Operation Id="o984">
<a:ObjectID>1B423577-CDAB-4D27-ABFF-F8A67D9F0B12</a:ObjectID>
<a:Name>保存合同-计日工信息/saveAgreementDailyWage</a:Name>
<a:Code>保存合同计日工信息saveAgreementDailyWage</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704484</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    if (CollectionUtil.isNotEmpty(agreementDailyWageList)) {
        for (AgreementDailyWage dailyWage : agreementDailyWageList) {
            dailyWage.setUnitMeasurement(&quot;工日&quot;);
            dailyWage.setUnitPriceExcTax(AmountCalUtil.calUnitPriceExclTax(dailyWage.getUnitPriceIncTax(),dailyWage.getTaxRate()));

            dailyWage.setAgreementId(agreementId);
        }

        super.saveBatch(agreementDailyWageList);
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o985">
<a:ObjectID>660CDF7B-CDD1-4C82-9296-B626CD1FE1C9</a:ObjectID>
<a:Name>agreementDailyWageList</a:Name>
<a:Code>agreementDailyWageList</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697635</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Parameter.DataType>List&lt;AgreementDailyWage&gt;</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o986">
<a:ObjectID>0E108B84-9BEF-4425-AB4F-673861C780D5</a:ObjectID>
<a:Name>agreementId</a:Name>
<a:Code>agreementId</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697635</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Parameter.DataType>Long</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
<c:InfluentObject>
<o:Shortcut Ref="o987"/>
</c:InfluentObject>
<c:Annotations>
<o:Annotation Id="o988">
<a:ObjectID>B8F3267B-C4F4-40D4-A5EC-7A976E620EE0</a:ObjectID>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697635</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Annotation.Name>Override</a:Annotation.Name>
</o:Annotation>
</c:Annotations>
</o:Operation>
<o:Operation Id="o989">
<a:ObjectID>E02D01FC-F91E-44A6-B190-1156553DC370</a:ObjectID>
<a:Name>根据合同编号获取合同-计日工/listByAgreementId</a:Name>
<a:Code>根据合同编号获取合同计日工listByAgreementId</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704484</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>List&lt;AgreementDailyWageVO&gt;</a:ReturnType>
<a:TemplateBody>{
    List&lt;AgreementDailyWage&gt; dailyWages = list(new LambdaQueryWrapper&lt;AgreementDailyWage&gt;()
            .eq(AgreementDailyWage::getAgreementId,agreementId));

    Map&lt;String,String&gt; jobTitleMap = underlingSystemService.listDictMap(DictBizEnum.UNDERLING_DATALLER_WORK_TYPE.getName());
    List&lt;AgreementDailyWageVO&gt; dailyWageList = BeanCopierUtil.copyList(dailyWages, AgreementDailyWageVO.class);

    for (AgreementDailyWageVO dailyWageVO : dailyWageList) {
        dailyWageVO.setJobTitleName(jobTitleMap.get(dailyWageVO.getJobTitleCode()));
    }

    return dailyWageList;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o990">
<a:ObjectID>B61FA3A5-38B6-4D43-AB58-5A88F4AB07AE</a:ObjectID>
