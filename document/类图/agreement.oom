    return new PageResult&lt;&gt;(pages);
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o7354">
<a:ObjectID>443FB527-746B-407E-9096-BEBB27EF8A93</a:ObjectID>
<a:Name>queryVO</a:Name>
<a:Code>queryVO</a:Code>
<a:CreationDate>1728697642</a:CreationDate>
