        SysDept sysDept = remoteSystemService.getByThridDeptId(thridDeptId, SecurityConstants.INNER);
        return Optional.ofNullable(sysDept)
                .map(SysDept::getDeptName)
                .orElse(&quot;&quot;);
    }
    return null;
}
