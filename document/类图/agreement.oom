<o:Operation Id="o3875">
<a:ObjectID>6371C4FD-9421-46C7-80EE-21E788D08036</a:ObjectID>
<a:Name>修改采购计划的合约拆分/updateContractPlanningSplit</a:Name>
<a:Code>修改采购计划的合约拆分updateContractPlanningSplit</a:Code>
<a:CreationDate>1728697638</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728701529</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    // 删除合约拆分记录
    baseMapper.deleteByPlanId(planId);

    // 删除物料信息
    materialsListService.deleteByPlanId(planId);

    // 保存信息
    this.saveContractPlanningSplit(splitRequestList,planId,priceType);
}
</a:TemplateBody>
