<a:ObjectID>AD474438-E2EC-4505-84C7-1FCFABC6EA6C</a:ObjectID>
<a:Name>获取供应商分类/getVendorClassifyName</a:Name>
<a:Code>获取供应商分类getVendorClassifyName</a:Code>
<a:CreationDate>1728697641</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706978</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>String</a:ReturnType>
<a:TemplateBody>{
    if (StringUtils.isBlank(ids)) {
        return null;
    }

    List&lt;Long&gt; enterpriseTypes = Arrays.stream(ids.split(&quot;,&quot;))
            .map(Long::parseLong)
            .collect(Collectors.toList());

    List&lt;VendorClassify&gt; vendorClassifyList = super.listByIds(enterpriseTypes);
    return vendorClassifyList.stream()
            .map(VendorClassify::getName)
            .collect(Collectors.joining(&quot;,&quot;));
}
</a:TemplateBody>
