<o:Operation Id="o7197">
<a:ObjectID>82F95DE3-CBA4-40E3-9AF9-C26903C508B8</a:ObjectID>
<a:Name>获取供应商分类子数据集合/getVendorClassifySubList</a:Name>
<a:Code>获取供应商分类子数据集合getVendorClassifySubList</a:Code>
<a:CreationDate>1728697641</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728706978</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>List&lt;VendorClassify&gt;</a:ReturnType>
<a:TemplateBody>{
    List&lt;VendorClassify&gt; classifyList = new ArrayList&lt;&gt;();
    List&lt;VendorClassify&gt; classifies = this.list(new LambdaQueryWrapper&lt;VendorClassify&gt;()
            .eq(VendorClassify::getParentId, id));
    if (!CollectionUtils.isEmpty(classifies)){
        classifyList.addAll(classifies);
        for (VendorClassify classify : classifies) {
            List&lt;VendorClassify&gt; parentList = getVendorClassifySubList(classify.getId());
            if (!CollectionUtils.isEmpty(parentList)){
                classifyList.addAll(parentList);
            }
        }
    }
    return classifyList;
}
</a:TemplateBody>
