<o:Operation Id="o1251">
<a:ObjectID>07C22D2B-739F-4E92-AA5E-8E4733172738</a:ObjectID>
<a:Name>获取供应商的签订合同/listVendorAgreement</a:Name>
<a:Code>获取供应商的签订合同listVendorAgreement</a:Code>
<a:CreationDate>1728697635</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728704235</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>PageResult&lt;VendorAgreementListVO&gt;</a:ReturnType>
<a:TemplateBody>{
    IPage&lt;VendorAgreementListVO&gt; page = baseMapper.selectVendorAgreementList(queryVO.toMybatisPage(),queryVO);

    VendorContact vendorContact = vendorContactService.getVendorContactByLoginUser(SecurityUtils.getUserId());
    for (VendorAgreementListVO agreementList : page.getRecords()) {
        if (vendorContact.getIsManager() == 1) {
            agreementList.setOperateFlag(1);
        } else {
            agreementList.setOperateFlag(0);
        }
    }

    return new PageResult&lt;&gt;(page);
}
</a:TemplateBody>
<c:Parameters>
