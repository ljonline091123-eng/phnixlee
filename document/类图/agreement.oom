<o:Operation Id="o5550">
<a:ObjectID>8E1CA511-1E0D-4270-A649-7D472AF8B613</a:ObjectID>
<a:Name>ProcurementSchemeBiddingVendorVO</a:Name>
<a:Code>ProcurementSchemeBiddingVendorVO</a:Code>
<a:CreationDate>1728697640</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697640</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:TemplateBody>{
    this.vendorId = vendorId;
    if (bidResult == 1) {
        this.vendorName = &quot;(中标)&quot; + vendorName;
    } else {
        this.vendorName = &quot;(未中标)&quot; + vendorName;
    }
}
</a:TemplateBody>
