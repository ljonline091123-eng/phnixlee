<c:Operations>
<o:Operation Id="o8540">
<a:ObjectID>DB2132B8-52BF-490A-9D6C-6B7C8AEDB5F4</a:ObjectID>
<a:Name>getVendorClassText</a:Name>
<a:Code>getVendorClassText</a:Code>
<a:CreationDate>1728697643</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1728697643</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:ReturnType>String</a:ReturnType>
<a:TemplateBody>{
    if (getIsBlack() == 1) {
        this.vendorClassText = &quot;黑名单&quot;;
    } else if (getState() == 1) {
        this.vendorClassText = &quot;待审供应商&quot;;
    } else if (getVendorClass() == 1) {
        this.vendorClassText = &quot;合格供应商&quot;;
    } else if (getVendorClass() == 2) {
        this.vendorClassText = &quot;战略供应商&quot;;
    }
    return this.vendorClassText;
}
</a:TemplateBody>
</o:Operation>
</c:Operations>
