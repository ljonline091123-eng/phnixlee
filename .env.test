# .env.test —— 测试环境（113.240.110.218：门户 1543 / 管理端 1544）
# 打包命令：npm run build:test
NODE_ENV = production
ENV = 'test'

# 页面标题
VUE_APP_TITLE = 招采系统

# 招采系统/测试环境（与 1544 站点 nginx 的 /dev-api 转发一致）
VUE_APP_BASE_API = '/dev-api'

# 供应商端(门户)统一登录页端口（退出/会话过期跳转，hostname 动态取）
# 端口分环境：本地开发 5173 / 测试 1543 / 生产 8193
VUE_APP_PORTAL_PORT = '1543'
