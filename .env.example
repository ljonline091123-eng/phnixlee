# Use PostgreSQL for shared/dev deployments.
# DATABASE_URL=postgresql+psycopg://quant_user:quant_password@127.0.0.1:5432/quant_agent

# SQLite is the local default when DATABASE_URL is not set.
APP_NAME=Gemini Quant Agent
APP_ENV=development
API_V1_PREFIX=/api/v1
SQL_ECHO=false
# Set a stable Fernet key before saving provider API credentials.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_CREDENTIAL_KEY=
LAKE_STORAGE_BACKEND=filesystem
LAKE_FILESYSTEM_ROOT=./backend/lake
LAKE_S3_ENDPOINT=127.0.0.1:9000
LAKE_S3_ACCESS_KEY=minioadmin
LAKE_S3_SECRET_KEY=minioadmin
LAKE_S3_BUCKET=quant-lake
LAKE_S3_SECURE=false
