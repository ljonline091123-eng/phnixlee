<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhaocai.business.procurement.mapper.ContractPlanningMapper">
    <resultMap type="com.zhaocai.business.procurement.domain.ContractPlanning" id="ContractPlanningResult">
        <result property="id" column="id"/>
        <result property="planId" column="plan_id"/>
        <result property="bidResponsibleOrg" column="bid_responsible_org"/>
        <result property="bidResponsibleOrgName" column="bid_responsible_org_name"/>
        <result property="contractPlanningCode" column="contract_planning_code"/>
        <result property="contractPlanningId" column="contract_planning_id"/>
        <result property="contractPlanningName" column="contract_planning_name"/>
        <result property="projectId" column="project_id"/>
        <result property="projectCode" column="project_code"/>
        <result property="projectName" column="project_name"/>
        <result property="contractPlanningCategory" column="contract_planning_category"/>
        <result property="contractPlanningCategoryName" column="contract_planning_category_name"/>
        <result property="plannedAmountInclTax" column="planned_amount_incl_tax"/>
        <result property="incurredPlannedAmount" column="incurred_planned_amount"/>
        <result property="planningBalance" column="planning_balance"/>
        <result property="biddingMethodCode" column="bidding_method_code"/>
        <result property="biddingMethodName" column="bidding_method_name"/>
        <result property="subjectMatter" column="subject_matter"/>
        <result property="brand" column="brand"/>
        <result property="createBy" column="create_by"/>
        <result property="createId" column="create_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateId" column="update_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <resultMap type="com.zhaocai.business.procurement.vo.res.ProcurementContractPlanListVO"
               id="ProcurementContractPlanResult">
        <result property="planId" column="plan_id"/>
        <result property="procurementPlanCode" column="procurement_plan_code"/>
        <result property="procurementPlanName" column="procurement_plan_name"/>
        <result property="contractPlanningCode" column="contract_planning_id"/>
        <result property="contractPlanningName" column="contract_planning_name"/>
        <result property="contractPlanningCategory" column="contract_planning_category_name"/>
        <result property="plannedAmountInclTax" column="planned_amount_incl_tax"/>
        <result property="incurredPlannedAmount" column="incurred_planned_amount"/>
        <result property="planningBalance" column="planning_balance"/>
        <result property="biddingMethod" column="bidding_method_name"/>
        <result property="projectCode" column="project_code"/>
        <result property="projectName" column="project_name"/>
    </resultMap>

    <select id="selectProcurementContractPlanningList" resultMap="ProcurementContractPlanResult">
        select tpp.id as plan_id,
            tpp.procurement_plan_code,
            tpp.procurement_plan_name,
            tp.contract_planning_id,
            tp.contract_planning_name,
            tp.contract_planning_category_name,
            tp.planned_amount_incl_tax,
            tp.incurred_planned_amount,
            tp.planning_balance,
            tp.bidding_method_name,
            tp.project_code,
            tp.project_name
            /* 合约规划对象 */
        from tb_contract_planning tp
            /* 采购计划对象 */
        inner join tb_procurement_plan tpp on tp.plan_id = tpp.id
        where tpp.id in
        <foreach collection="planIds" item="item" open="(" separator="," close=")">
            #{item,jdbcType=BIGINT}
        </foreach>
    </select>

    <select id="selectByContractSplitId" resultMap="ContractPlanningResult">
        select tcp.*
        from tb_contract_planning tcp
        inner join tb_contract_planning_split tps on tcp.plan_id = tps.procurement_plan_id
        where tps.id = #{splitId,jdbcType=BIGINT}
    </select>

    <delete id="deleteByPlanId">
        delete from tb_contract_planning where plan_id = #{planId,jdbcType=BIGINT}
    </delete>
</mapper>
