<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhaocai.business.vendor.mapper.TInterfaceLogMapper">

    <resultMap type="com.zhaocai.business.vendor.domain.TInterfaceLog" id="TInterfaceLogResult">
        <result property="id" column="id"/>
        <result property="sendTime" column="send_time"/>
        <result property="sendData" column="send_data"/>
        <result property="sendUrl" column="send_url"/>
        <result property="receiveData" column="receive_data"/>
        <result property="receiveTime" column="receive_time"/>
        <result property="logType" column="log_type"/>
        <result property="businessId" column="business_id"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectTInterfaceLogVo">
        select id, send_time, send_data, send_url, receive_data, receive_time, log_type, flag, business_id ,remark
        from t_interface_log
    </sql>

    <select id="selectLikeList" parameterType="com.zhaocai.business.vendor.domain.TInterfaceLog" resultMap="TInterfaceLogResult">
        <include refid="selectTInterfaceLogVo"/>
        <where>
            <if test="sendTime != null ">and send_time = #{sendTime}</if>
            <if test="sendData != null  and sendData != ''">and send_data like concat('%',#{sendData},'%')</if>
            <if test="sendUrl != null  and sendUrl != ''">and send_url = #{sendUrl}</if>
            <if test="receiveData != null  and receiveData != ''">and receive_data like concat('%',#{receiveData},'%')
            </if>
            <if test="receiveTime != null ">and receive_time = #{receiveTime}</if>
            <if test="logType != null  and logType != ''">and log_type = #{logType}</if>
            <if test="flag != null  and flag != ''">and flag = #{flag}</if>
            <if test="businessId != null  and businessId != ''">and business_id = #{businessId}</if>
        </where>
        order by send_time desc
    </select>

    <select id="selectTInterfaceLogList" parameterType="com.zhaocai.business.vendor.domain.TInterfaceLog" resultMap="TInterfaceLogResult">
        <include refid="selectTInterfaceLogVo"/>
        <where>
            <if test="sendTime != null ">and send_time = #{sendTime}</if>
            <if test="sendData != null  and sendData != ''">and send_data = #{sendData}</if>
            <if test="sendUrl != null  and sendUrl != ''">and send_url = #{sendUrl}</if>
            <if test="receiveData != null  and receiveData != ''">and receive_data = #{receiveData}</if>
            <if test="receiveTime != null ">and receive_time = #{receiveTime}</if>
            <if test="logType != null  and logType != ''">and log_type = #{logType}</if>
            <if test="flag != null  and flag != ''">and flag = #{flag}</if>
            <if test="businessId != null  and businessId != ''">and business_id = #{businessId}</if>
        </where>
        order by send_time desc
    </select>

    <select id="selectTInterfaceLogById" parameterType="Long" resultMap="TInterfaceLogResult">
        <include refid="selectTInterfaceLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertTInterfaceLog" parameterType="com.zhaocai.business.vendor.domain.TInterfaceLog">
        insert into t_interface_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="sendTime != null">send_time,</if>
            <if test="sendData != null">send_data,</if>
            <if test="sendUrl != null">send_url,</if>
            <if test="receiveData != null">receive_data,</if>
            <if test="receiveTime != null">receive_time,</if>
            <if test="logType != null">log_type,</if>
            <if test="flag != null">flag,</if>
            <if test="businessId != null">business_id,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="sendTime != null">#{sendTime},</if>
            <if test="sendData != null">#{sendData},</if>
            <if test="sendUrl != null">#{sendUrl},</if>
            <if test="receiveData != null">#{receiveData},</if>
            <if test="receiveTime != null">#{receiveTime},</if>
            <if test="logType != null">#{logType},</if>
            <if test="flag != null">#{flag},</if>
            <if test="businessId != null and businessId != ''">#{businessId},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="updateTInterfaceLog" parameterType="com.zhaocai.business.vendor.domain.TInterfaceLog">
        update t_interface_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="sendTime != null">send_time = #{sendTime},</if>
            <if test="sendData != null">send_data = #{sendData},</if>
            <if test="sendUrl != null">send_url = #{sendUrl},</if>
            <if test="receiveData != null">receive_data = #{receiveData},</if>
            <if test="receiveTime != null">receive_time = #{receiveTime},</if>
            <if test="logType != null">log_type = #{logType},</if>
            <if test="flag != null">flag = #{flag},</if>
            <if test="businessId != null and businessId != ''">business_id = #{businessId},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTInterfaceLogById" parameterType="Long">
        delete
        from t_interface_log
        where id = #{id}
    </delete>

    <delete id="deleteTInterfaceLogByIds" parameterType="String">
        delete from t_interface_log where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
