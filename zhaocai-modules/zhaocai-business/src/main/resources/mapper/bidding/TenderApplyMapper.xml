<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhaocai.business.bidding.mapper.TenderApplyMapper">
    
    <resultMap type="com.zhaocai.business.bidding.domain.TenderApply" id="TenderApplyResult">
        <result property="id"    column="id"    />
        <result property="noticeId"    column="notice_id"    />
        <result property="contact"    column="contact"    />
        <result property="phone"    column="phone"    />
        <result property="attachId"    column="attach_id"    />
        <result property="vendorId"    column="vendor_id"    />
        <result property="vendorName"    column="vendor_name"    />
        <result property="ipAddress"    column="ip_address"    />
        <result property="approveResult"    column="approve_result"    />
    </resultMap>

    <sql id="selectTenderApplyVo">
        select id, notice_id, contact, phone, attach_id, vendor_id, vendor_name, ip_address, approve_result from tb_tender_apply
    </sql>

    <select id="selectTenderApplyList" parameterType="com.zhaocai.business.bidding.domain.TenderApply" resultMap="TenderApplyResult">
        <include refid="selectTenderApplyVo"/>
        <where>  
            <if test="noticeId != null "> and notice_id = #{noticeId}</if>
            <if test="contact != null  and contact != ''"> and contact = #{contact}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="attachId != null "> and attach_id = #{attachId}</if>
            <if test="vendorId != null "> and vendor_id = #{vendorId}</if>
            <if test="vendorName != null  and vendorName != ''"> and vendor_name like concat('%', #{vendorName}, '%')</if>
            <if test="ipAddress != null  and ipAddress != ''"> and ip_address = #{ipAddress}</if>
            <if test="approveResult != null "> and approve_result = #{approveResult}</if>
        </where>
    </select>
    
    <select id="selectTenderApplyById" parameterType="Long" resultMap="TenderApplyResult">
        <include refid="selectTenderApplyVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertTenderApply" parameterType="com.zhaocai.business.bidding.domain.TenderApply">
        insert into tb_tender_apply
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="noticeId != null">notice_id,</if>
            <if test="contact != null">contact,</if>
            <if test="phone != null">phone,</if>
            <if test="attachId != null">attach_id,</if>
            <if test="vendorId != null">vendor_id,</if>
            <if test="vendorName != null">vendor_name,</if>
            <if test="ipAddress != null">ip_address,</if>
            <if test="approveResult != null">approve_result,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="noticeId != null">#{noticeId},</if>
            <if test="contact != null">#{contact},</if>
            <if test="phone != null">#{phone},</if>
            <if test="attachId != null">#{attachId},</if>
            <if test="vendorId != null">#{vendorId},</if>
            <if test="vendorName != null">#{vendorName},</if>
            <if test="ipAddress != null">#{ipAddress},</if>
            <if test="approveResult != null">#{approveResult},</if>
         </trim>
    </insert>

    <update id="updateTenderApply" parameterType="com.zhaocai.business.bidding.domain.TenderApply">
        update tb_tender_apply
        <trim prefix="SET" suffixOverrides=",">
            <if test="noticeId != null">notice_id = #{noticeId},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="attachId != null">attach_id = #{attachId},</if>
            <if test="vendorId != null">vendor_id = #{vendorId},</if>
            <if test="vendorName != null">vendor_name = #{vendorName},</if>
            <if test="ipAddress != null">ip_address = #{ipAddress},</if>
            <if test="approveResult != null">approve_result = #{approveResult},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTenderApplyById" parameterType="Long">
        delete from tb_tender_apply where id = #{id}
    </delete>

    <delete id="deleteTenderApplyByIds" parameterType="String">
        delete from tb_tender_apply where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>