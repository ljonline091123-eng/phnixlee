    <select id="selectAgreementMaterialsList" resultMap="AgreementMaterialsListVOResult">
        select taml.agreement_id,taml.materials_list_id,taml.bidding_list_quotation_id, tml.materials_code,tml.materials_name,tml.subject_matter_code,tml.subject_matter_name,
                tml.specification,tml.unit_measurement,tml.measurement_rules,tml.work_content,tml.cost_account_name,
                tml.count,tblq.tax_unit_price,tblq.not_tax_unit_price,tblq.tax_price,tblq.not_tax_price,tblq.tax_rate,tblq.bill_type,taml.brand,taml.payment_type,
                taml.rental_unit,taml.workload,taml.remark,tml.floating_price,tml.unloading_fee,tml.base_price,tml.rent_mode,tml.rent_time,tml.rent_quantity,taml.sign_count,
                taml.sign_unit_price_incl_tax,taml.sign_unit_price_excl_tax,taml.sign_amount_incl_tax,taml.sign_amount_excl_tax,taml.sign_tax_rate,taml.contract_split_id
        from tb_agreement_materials_list taml
        inner join tb_agreement ta on ta.id = taml.agreement_id
        inner join tb_materials_list tml on tml.id = taml.materials_list_id and tml.contract_split_id = ta.contract_split_id
        inner join tb_bidding_list_quotation tblq on tblq.id = taml.bidding_list_quotation_id and tblq.materials_id = tml.id
        where taml.agreement_id = #{agreementId,jdbcType=BIGINT}
    </select>

    <resultMap type="com.zhaocai.business.agreement.vo.res.AgreementUnderlingMaterialsVO" id="UnderlingMaterialsListResult">
