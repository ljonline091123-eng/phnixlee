<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhaocai.business.agreement.mapper.AgreementPaymentItemMapper">
    <resultMap type="com.zhaocai.business.agreement.domain.AgreementPaymentItem" id="AgreementPaymentItemResult">
        <result property="id" column="id"/>
        <result property="agreementId" column="agreement_id"/>
        <result property="currency" column="currency"/>
        <result property="invoiceType" column="invoice_type"/>
        <result property="contractTaxRate" column="contract_tax_rate"/>
        <result property="prepaymentRatio" column="prepayment_ratio"/>
        <result property="prepaymentAmount" column="prepayment_amount"/>
        <result property="prepaymentDeductionConditions" column="prepayment_deduction_conditions"/>
        <result property="prepaymentDeductionDeadline" column="prepayment_deduction_deadline"/>
        <result property="outOfSettlementRatio" column="out_of_settlement_ratio"/>
        <result property="isRelatedMySteel" column="is_related_my_steel"/>
        <result property="mySteelPriceFluctuation" column="my_steel_price_fluctuation"/>
        <result property="stagnationRatio" column="stagnation_ratio"/>
        <result property="createBy" column="create_by"/>
        <result property="createId" column="create_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateId" column="update_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <delete id="deleteByAgreementId">
        delete from tb_agreement_payment_item where agreement_id = #{agreementId,jdbcType=BIGINT}
    </delete>
</mapper>
